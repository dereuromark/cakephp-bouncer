{
    "name": "dereuromark/cakephp-bouncer",
    "description": "CakePHP plugin for approval workflow - users propose changes, admins approve or reject before publishing",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "plugin",
        "approval",
        "workflow",
        "moderation",
        "admin-panel",
        "standalone-ui",
        "draft",
        "bouncer"
    ],
    "homepage": "https://dereuromark.github.io/cakephp-bouncer/",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Scherer",
            "role": "Author",
            "homepage": "https://www.dereuromark.de"
        }
    ],
    "require": {
        "php": ">=8.5",
        "cakephp/orm": "^6.0@dev",
        "ext-json": "*",
        "sebastian/diff": "^6.0 || ^7.0 || ^8.0 || ^9.0"
    },
    "require-dev": {
        "cakephp/cakephp": "^6.0@dev",
        "dereuromark/cakephp-i18n-lint": "dev-cake6",
        "phpunit/phpunit": "^13.0",
        "php-collective/code-sniffer": "dev-master as 0.4.6",
        "cakephp/migrations": "dev-fix/6.x-cakephp-compatibility",
        "dereuromark/cakephp-templating": "dev-cake6"
    },
    "suggest": {
        "dereuromark/cakephp-audit-stash": "Integrates seamlessly to provide complete audit trail of approval workflow",
        "jfcherng/php-diff": "For enhanced word-level diff rendering in BouncerHelper (falls back to sebastian/diff if not installed)"
    },
    "autoload": {
        "psr-4": {
            "Bouncer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bouncer\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "stan": "phpstan analyze",
        "stan-setup": "cp composer.json composer.backup && composer require --dev phpstan/phpstan:^2.0.0 && mv composer.backup composer.json",
        "test": "phpunit",
        "coverage-test": "phpunit --stderr --coverage-clover=clover.xml",
        "i18n-check": "i18n-lint check",
        "i18n-extract": "i18n-lint extract",
        "i18n-lint": "i18n-lint lint"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
